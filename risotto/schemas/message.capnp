@0xb76652ea6f23bb15;

# One BMP message (RFC 7854), as seen by the Risotto collector.
#
# Every message carries the common fields below and exactly one non-null body,
# selected by `messageType`. Route Monitoring messages are flattened: one
# message per prefix. IP addresses are 16-byte IPv6 (IPv4 is IPv4-mapped).
struct Message {
    timeReceivedNs      @0  :UInt64;   # time the collector decoded the message
    routerAddr          @1  :Data;
    routerPort          @2  :UInt16;
    sessionStartNs      @3  :UInt64;   # BMP session (TCP connection) establishment time
    synthetic           @4  :Bool;     # generated by the collector, not sent by the router
    messageType         @5  :UInt8;    # 0 RouteMonitoring, 1 StatsReport, 2 PeerDown, 3 PeerUp,
                                       # 4 Initiation, 5 Termination, 6 RouteMirroring
    sequence            @13 :UInt64;   # position in the session, a gap means lost messages

    peerHeader          @6  :PeerHeader;   # null for Initiation and Termination

    routeMonitoring     @7  :RouteMonitoring;
    statsReport         @8  :StatsReport;
    peerDown            @9  :PeerDown;
    peerUp              @10 :PeerUp;
    initiation          @11 :Initiation;
    termination         @12 :Termination;
}

struct PeerHeader {
    peerType            @0  :UInt8;
    peerFlags           @1  :UInt8;
    peerDistinguisher   @2  :UInt64;
    peerAddr            @3  :Data;
    peerAsn             @4  :UInt32;
    peerBgpId           @5  :UInt32;
    timestampNs         @6  :UInt64;
    isPostPolicy        @7  :Bool;
    isAdjRibOut         @8  :Bool;
}

struct RouteMonitoring {
    prefixAddr          @0  :Data;
    prefixLen           @1  :UInt8;
    pathId              @2  :UInt32;
    announced           @3  :Bool;

    origin              @4  :Text;
    asPath              @5  :List(UInt32);
    nextHop             @6  :Data;
    multiExitDisc       @7  :UInt32;
    localPreference     @8  :UInt32;
    onlyToCustomer      @9  :UInt32;
    atomicAggregate     @10 :Bool;
    aggregatorAsn       @11 :UInt32;
    aggregatorBgpId     @12 :UInt32;
    communities         @13 :List(Community);
    extendedCommunities @14 :List(ExtendedCommunity);
    largeCommunities    @15 :List(LargeCommunity);
    originatorId        @16 :UInt32;
    clusterList         @17 :List(UInt32);
    mpReachAfi          @18 :UInt16;
    mpReachSafi         @19 :UInt8;
    mpUnreachAfi        @20 :UInt16;
    mpUnreachSafi       @21 :UInt8;
    afi                 @22 :UInt16;   # address family of the prefix (1/1 for IPv4 unicast)
    safi                @23 :UInt8;
    initialDump         @24 :Bool;     # received before the End-of-RIB following Peer Up
}

struct Community {
    asn                 @0  :UInt32;
    value               @1  :UInt16;
}

struct ExtendedCommunity {
    typeHigh            @0  :UInt8;
    typeLow             @1  :UInt8;
    value               @2  :Data;
}

struct LargeCommunity {
    globalAdmin         @0  :UInt32;
    localDataPart1      @1  :UInt32;
    localDataPart2      @2  :UInt32;
}

struct StatsReport {
    counters            @0  :List(StatCounter);
}

struct StatCounter {
    statType            @0  :UInt16;
    afi                 @1  :UInt16;   # 0 when not a per-AFI/SAFI gauge
    safi                @2  :UInt8;
    value               @3  :UInt64;
}

struct PeerDown {
    reason              @0  :UInt8;
    data                @1  :Data;
    notificationCode    @2  :UInt8;    # reasons 1 and 3
    notificationSubcode @3  :UInt8;
    fsmEventCode        @4  :UInt16;   # reason 2
}

struct PeerUp {
    localAddr           @0  :Data;
    localPort           @1  :UInt16;
    remotePort          @2  :UInt16;
    sentOpen            @3  :OpenMessage;
    receivedOpen        @4  :OpenMessage;
    information         @5  :List(InformationTlv);
}

struct OpenMessage {
    version             @0  :UInt8;
    asn                 @1  :UInt32;
    holdTime            @2  :UInt16;
    bgpId               @3  :UInt32;
    capabilities        @4  :List(UInt8);
}

struct Initiation {
    information         @0  :List(InformationTlv);
}

struct Termination {
    reason              @0  :UInt16;
    information         @1  :List(InformationTlv);
}

struct InformationTlv {
    infoType            @0  :UInt16;
    value               @1  :Text;
}
